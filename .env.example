MAIL_PROVIDER=
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
PUBLIC_WEBSITE_URL=
## LocationIQ Static Maps: server-side token only; reserve quota for other account usage.
LOCATIONIQ_API_KEY=
LOCATIONIQ_DAILY_BUDGET=4500

# Firebase HTTP v1 push delivery; store service-account JSON only in secret environments.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Storage is required for firmware/APK uploads; there are no built-in credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
# Google sign-in: use the allowed web/Android OAuth client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage
# Optional override for Android FCM delivery restrictions.
ANDROID_PACKAGE_NAME=com.example.justride_ui
